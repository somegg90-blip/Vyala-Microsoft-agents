# QuantumShield Learning Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Azure AI Foundry ─────────────────────────────────────────────────────
# Your Foundry project endpoint (from Foundry Portal → Project → Overview)
FOUNDRY_PROJECT_ENDPOINT=https://your-ai-services.services.ai.azure.com/api/projects/your-project

# Model deployment name (must be deployed in your Foundry project)
FOUNDRY_MODEL=gpt-4.1

# ── Azure AI Search (Foundry IQ backend) ─────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net

# Knowledge base name (created in Foundry Portal → Knowledge bases)
KB_NAME=pqc-kb

# Foundry project connection name for the KB MCP endpoint
# (created in Foundry Portal → Connections → RemoteTool)
KB_CONNECTION_NAME=pqc-kb-connection

# ── GitHub MCP ───────────────────────────────────────────────────────────
# Foundry project connection name for GitHub PAT
# (created in Foundry Portal → Connections → GitHub)
GITHUB_CONNECTION_NAME=github-pat-connection

# ── Agent settings ───────────────────────────────────────────────────────
# Refuse recommendations below this confidence threshold (default: 0.70)
CONFIDENCE_THRESHOLD=0.70

# ── API server ───────────────────────────────────────────────────────────
PORT=8000
